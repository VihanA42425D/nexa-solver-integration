# Public Solver API.
NEXA_SOLVER_BASE_URL=https://solver.vsnexa.com
NEXA_SOURCE_CHAIN_ID=8453
NEXA_SOURCE_NETWORK_ID=

# EVM Permit example. Never commit signatures or private keys.
NEXA_QUOTE_ID=
NEXA_REQUESTED_AMOUNT_IN_RAW=
NEXA_STANDARD=DIRECT
NEXA_PAYER=
NEXA_RECIPIENT=
NEXA_IDEMPOTENCY_KEY=
NEXA_REQUEST_SIGNATURE=

# Optional RPCs used only after the V6 public deployment bundle is ACTIVE.
NEXA_BASE_RPC_URL=https://mainnet.base.org
NEXA_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXA_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Worker production bindings must be configured with `wrangler secret put`, never committed:
# SOLVER_ORIGIN_URL
# CF_ACCESS_CLIENT_ID
# CF_ACCESS_CLIENT_SECRET
# NEXA_V6_EDGE_TELEMETRY_HMAC_SECRET
