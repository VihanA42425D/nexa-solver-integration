{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "nexa-solver-integration-manifest/v3",
  "name": "Nexa Solver Integration",
  "environment": "mainnet",
  "deploymentVersion": 6,
  "release": "NEXA_MAINNET_V6",
  "releaseId": "0xcc0dc051739f2dafaebd2eb5663937850dcc3e7951e38f437e00fcd9fa6c8ff6",
  "deploymentStatus": "ACTIVE",
  "publicSurfaceOnly": true,
  "canonicalBundle": "./nexa-mainnet-v6.json",
  "solverProfile": {
    "executionScopes": [
      "INTRA_CHAIN",
      "CROSS_CHAIN"
    ],
    "automatedDiscovery": true,
    "variableSizeExecution": true,
    "machineVerifiableState": true,
    "accountlessDiscovery": true
  },
  "discovery": {
    "routeCatalog": "MACHINE_READABLE_V6_ROUTE_CATALOG",
    "liveTerms": "SIGNED_EXECUTION_FEED"
  },
  "authentication": "WALLET_OR_NATIVE_ACCOUNT_PROOF",
  "standards": "./standards/standard-ids.json",
  "events": "./events/events.json",
  "examples": {
    "discoverRoutes": "./examples/discover-open-routes.mjs",
    "requestPermit": "./examples/request-execution-permit.mjs",
    "config": "./config/example.config.json"
  },
  "privateDetailsExcluded": [
    "internal-contract-addresses",
    "custody-infrastructure",
    "authorization-infrastructure",
    "clearing-infrastructure",
    "operator-infrastructure",
    "pricing-policy",
    "risk-policy",
    "capital-policy",
    "business-logic"
  ]
}
