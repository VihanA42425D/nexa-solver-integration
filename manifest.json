{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "nexa-solver-integration-manifest/v2",
  "name": "Nexa Solver Integration",
  "environment": "mainnet",
  "deploymentVersion": 6,
  "release": "NEXA_MAINNET_V6",
  "releaseId": "0xcc0dc051739f2dafaebd2eb5663937850dcc3e7951e38f437e00fcd9fa6c8ff6",
  "deploymentStatus": "AWAITING_POST_DEPLOY_EXPORT",
  "publicSurfaceOnly": true,
  "canonicalBundle": "./nexa-mainnet-v6.json",
  "executionModel": {
    "type": "DIRECT_INVENTORY_SETTLEMENT",
    "successfulFillTransactionCount": 2,
    "sourceTransactionCount": 1,
    "destinationTransactionCount": 1,
    "variableSizeRoute": true,
    "exactAmountPermit": true,
    "feedPricing": "INDICATIVE_ENVELOPE_REPRICE_AT_PERMIT",
    "periodicPublicationTransactions": 0,
    "embeddedDexSwap": false,
    "embeddedBridge": false,
    "solverPrivateCostsNotGuaranteed": true,
    "netProfitNotGuaranteed": true
  },
  "discovery": {
    "routeCatalog": "ONCHAIN_REGISTRY_V6",
    "liveTerms": "SIGNED_OFFCHAIN_FEED",
    "allDiscoverableRoutesMayBeReturned": true,
    "discoverableIsDistinctFromExecutable": true
  },
  "authentication": "WALLET_OR_NATIVE_ACCOUNT_PROOF_NO_LOGIN_SESSION_OR_COOKIE",
  "standards": "./standards/standard-ids.json",
  "events": "./events/events.json",
  "examples": {
    "discoverRoutes": "./examples/discover-open-routes.mjs",
    "requestPermit": "./examples/request-execution-permit.mjs",
    "config": "./config/example.config.json"
  },
  "deprecated": [
    "Reservation",
    "ReservationReceipt",
    "DestinationCommitment",
    "Coordinator",
    "SolverLane",
    "markFilled",
    "fixed 24-hour rotation",
    "V5 reservation-first adapters"
  ],
  "excluded": [
    "private-rpc",
    "private-pricing-policy",
    "private-risk-policy",
    "private-capital-policy",
    "kms",
    "clearing-internals",
    "business-logic"
  ]
}
