{
  "name": "@nexa/solver-integration",
  "version": "1.0.0",
  "description": "Public, read-only integration surface and examples for Nexa solvers.",
  "type": "module",
  "private": false,
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "abis",
    "addresses",
    "config",
    "events",
    "examples",
    "src",
    "public",
    "standards",
    "manifest.json",
    "wrangler.jsonc",
    "scripts",
    "test"
  ],
  "scripts": {
    "discover": "node examples/discover-open-routes.mjs",
    "generate:solver-manifest": "node scripts/generate-nexa-solver-manifest.mjs",
    "watch:requests": "node examples/watch-reservation-requests.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:deploy": "npm run validate && wrangler deploy",
    "worker:dev": "npm run validate && wrangler dev",
    "verify:onchain": "node scripts/verify-onchain.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VihanA42425D/nexa-solver-integration.git"
  },
  "homepage": "https://github.com/VihanA42425D/nexa-solver-integration#readme",
  "bugs": {
    "url": "https://github.com/VihanA42425D/nexa-solver-integration/issues"
  },
  "keywords": [
    "nexa",
    "solver",
    "erc-7683",
    "oif",
    "cross-chain"
  ],
  "exports": {
    ".": "./src/load-public-surface.mjs",
    "./oif": "./src/oif-adapter.mjs",
    "./endpoints": "./src/public-endpoints.mjs",
    "./manifest.json": "./manifest.json",
    "./addresses/mainnet.json": "./addresses/mainnet.json",
    "./standards/standard-ids.json": "./standards/standard-ids.json"
  }
}
