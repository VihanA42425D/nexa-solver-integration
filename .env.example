# Public Solver API.
NEXA_SOLVER_BASE_URL=https://solver.vsnexa.com
NEXA_SOURCE_CHAIN_ID=8453
NEXA_SOURCE_NETWORK_ID=

# EVM Permit example. Never commit signatures or private keys.
NEXA_QUOTE_ID=
NEXA_REQUESTED_AMOUNT_IN_RAW=
NEXA_STANDARD=DIRECT
NEXA_PAYER=
NEXA_RECIPIENT=
NEXA_IDEMPOTENCY_KEY=
NEXA_REQUEST_SIGNATURE=

# Optional RPCs for public onchain verification.
NEXA_BASE_RPC_URL=https://mainnet.base.org
NEXA_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXA_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Solver-facing V6 addresses only.
NEXA_V6_BASE_REGISTRY_ADDRESS=0x3db7752f052ACFECB3DA99BeE7c6a34D22367141
NEXA_V6_BASE_ROUTER_ADDRESS=0x9eA675a496b6a2D13B3091F6e6eB3f87183C3938
NEXA_V6_BSC_REGISTRY_ADDRESS=0x3db7752f052ACFECB3DA99BeE7c6a34D22367141
NEXA_V6_BSC_ROUTER_ADDRESS=0x9eA675a496b6a2D13B3091F6e6eB3f87183C3938
NEXA_V6_HYPEREVM_REGISTRY_ADDRESS=0x3db7752f052ACFECB3DA99BeE7c6a34D22367141
NEXA_V6_HYPEREVM_ROUTER_ADDRESS=0x9eA675a496b6a2D13B3091F6e6eB3f87183C3938

# Worker production bindings must be configured as secrets, never committed:
# SOLVER_ORIGIN_URL
# CF_ACCESS_CLIENT_ID
# CF_ACCESS_CLIENT_SECRET
# NEXA_V6_EDGE_TELEMETRY_HMAC_SECRET
